# Your Vapi Public Key (Found in Vapi Dashboard -> API Keys)
# IMPORTANT: Use the Public key, NEVER expose your Private Secret key in frontend code.
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key_here

# Your Vapi Assistant ID (Found in Vapi Dashboard -> Assistants)
VITE_VAPI_ASSISTANT_ID=your_assistant_uuid_here
